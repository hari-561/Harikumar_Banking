
# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=banking_loan_db

# JWT Authentication
# Replace with a randomly generated secret of at least 32 characters.
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# FastAPI Backend
API_BASE_URL=http://127.0.0.1:8000
